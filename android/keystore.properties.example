# Credenciales de firma del APK de release.
#
# Copiar a android/keystore.properties (que está en .gitignore) y rellenar.
# Sin este archivo el build de release funciona pero produce un APK SIN FIRMAR,
# que Android no instala y Play Store no acepta.
#
# Para generar el keystore:
#
#   keytool -genkeypair -v \
#     -keystore android/inkwell-release.jks \
#     -alias inkwell \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype PKCS12
#
# ⚠️ El .jks NO va al repo (ya está en .gitignore). Guardarlo en un gestor de
#    contraseñas junto con las claves de abajo. Si se pierde y la app usa firma
#    local, no hay forma de volver a publicar actualizaciones de la misma app.
#    Con Play App Signing esta llave es solo la de SUBIDA y Google puede
#    resetearla — pero igual hay que reportarlo y esperar.
#
# Después de generar o cambiar el keystore: npm run assetlinks
# (regenera public/.well-known/assetlinks.json con la huella nueva)

# Ruta al keystore, relativa a la carpeta android/
storeFile=inkwell-release.jks

# Contraseña del keystore (la que pediste al correr keytool)
storePassword=CAMBIAR

# Alias de la llave dentro del keystore
keyAlias=inkwell

# Contraseña de la llave. Con -storetype PKCS12 suele ser la misma que storePassword.
keyPassword=CAMBIAR
