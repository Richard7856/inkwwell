# Worker InkAR — variables de entorno
# Copiar a .env y rellenar. `.env` está en .gitignore: nunca se sube.
# En Railway van en Variables; en local se cargan con:
#     node --env-file=.env index.js

# Puerto del servidor (Railway lo sobreescribe automáticamente)
PORT=3001

# ── Generación de video (POST /generar) ──
# Sin estas cuatro, /generar responde 503 no_configurado y el resto del worker
# (compilación, análisis) sigue funcionando igual.

# Supabase → Settings → API → Project URL. Es la misma que VITE_SUPABASE_URL.
SUPABASE_URL=

# Supabase → Settings → API → service_role (NO la anon). SECRETA: con ella se
# escribe en tablas que el cliente no puede tocar. Jamás al repo ni al bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Higgsfield CLOUD → API keys (la API, no el plan Plus del panel: son cuentas
# y cobros distintos). Una llave tiene id y secreto.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=

# Opcionales. Modelo por defecto: Seedance lite (imagen-a-video, 9:16).
# Alternativas en higgsfield.js: /veo3.1/image-to-video, Kling…
# HIGGSFIELD_ENDPOINT=/bytedance/seedance/v1/lite/image-to-video
# HIGGSFIELD_DURACION=6
