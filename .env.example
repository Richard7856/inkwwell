# Inkwell AR — Variables de entorno
# Copiar a .env y rellenar con tus credenciales reales
# NUNCA commitear .env — está en .gitignore

# === SUPABASE ===
# Obtener en: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>

# === WORKER DE COMPILACIÓN .mind ===
# Para desarrollo local con ngrok:
#   1. cd worker && npm install && node index.js
#   2. En otra terminal: ngrok http 3001
#   3. Pegar la URL HTTPS de ngrok aquí (sin slash final)
# Para producción (Railway):
#   Pegar la URL del servicio Railway
VITE_COMPILER_URL=https://<tu-id>.ngrok-free.app

# === URL PÚBLICA DEL SITIO ===
# Dominio real donde vive la versión web. Se usa para construir los links de
# escaneo que el usuario comparte (/scan?tattoo=<uuid>).
#
# OBLIGATORIA para builds del APK: dentro del WebView, window.location.origin
# es "https://localhost", así que sin esta variable los links compartidos desde
# la app apuntarían a localhost y no abrirían en ningún otro dispositivo.
#
# En web es opcional — si se omite se usa window.location.origin, lo que hace
# que dev y los previews de Vercel funcionen sin configurar nada.
VITE_PUBLIC_URL=https://<tu-dominio>.vercel.app
